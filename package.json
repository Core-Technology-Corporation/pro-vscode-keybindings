{
  "name": "pro-vscode-keybindings",
  "displayName": "Pro VSCode Keybindings",
  "description": "Professional, productivity-focused keyboard shortcuts for Visual Studio Code.",
  "version": "1.0.8",
  "publisher": "alvarosiles",
  "license": "MIT",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.93.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "Keymaps",
    "Other"
  ],
  "keywords": [
    "keybindings",
    "keymap",
    "shortcuts",
    "productivity",
    "keyboard",
    "git",
    "debug",
    "terminal",
    "copilot"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/alvarosiles/pro-vscode-keybindings.git"
  },
  "bugs": {
    "url": "https://github.com/alvarosiles/pro-vscode-keybindings/issues"
  },
  "homepage": "https://github.com/alvarosiles/pro-vscode-keybindings#readme",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "scripts": {
    "build:keybindings": "node scripts/build.js",
    "build:extension": "esbuild extension/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18",
    "build": "npm run build:keybindings && npm run build:extension",
    "watch": "npm run build:extension -- --watch",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.93.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.0",
    "vsce": "^2.15.0"
  },
  "overrides": {
    "cheerio": "1.0.0-rc.12"
  },
  "contributes": {
    "commands": [
      {
        "command": "proKeybindings.detectProjectType",
        "title": "Pro Keybindings: Detect Project Type"
      },
      {
        "command": "proKeybindings.smartRun",
        "title": "Pro Keybindings: Smart Run (Debug / Web / Package)"
      },
      {
        "command": "proKeybindings.quickCommit",
        "title": "Pro Keybindings: Quick Commit (fill Summary/Description)"
      },
      {
        "command": "proKeybindings.openGitHubDesktop",
        "title": "Pro Keybindings: Open in GitHub Desktop"
      },
      {
        "command": "proKeybindings.commitMessagePicker",
        "title": "Pro Keybindings: Commit Message Picker"
      },
      {
        "command": "proKeybindings.formatWithConsoles",
        "title": "♻️ Limpiar consolas"
      },
      {
        "command": "proKeybindings.openSelectedFolderInNewWindow",
        "title": "🚀 Abrir en VS Code",
        "icon": "$(rocket)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "proKeybindings.formatWithConsoles",
          "when": "editorTextFocus && resourceExtname =~ /\\.(ts|tsx|js|jsx|mjs|cjs|vue|svelte|astro)$/",
          "group": "1_modification"
        }
      ],
      "explorer/context": [
        {
          "command": "proKeybindings.openSelectedFolderInNewWindow",
          "when": "filesExplorerFocus",
          "group": "navigation"
        },
        {
          "command": "proKeybindings.formatWithConsoles",
          "when": "filesExplorerFocus && resourceExtname =~ /\\.(ts|tsx|js|jsx|mjs|cjs|vue|svelte|astro)$/",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "proKeybindings.openSelectedFolderInNewWindow",
          "when": "view == workbench.explorer.fileView",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "key": "ctrl+shift+c+v",
        "command": "workbench.view.extension.claude-sessions-sidebar"
      },
      {
        "key": "ctrl+shift+c",
        "command": "workbench.view.extension.claude-sidebar-secondary"
      },
      {
        "key": "ctrl+f5",
        "command": "mysql.runSQLWithoutParse",
        "when": "editorLangId =~ /sql|dbclient-js|cql|postgres/ || resourceFilename =~ /.sql$/"
      },
      {
        "key": "ctrl+f5",
        "command": "workbench.action.reloadWindow",
        "when": "!(editorLangId =~ /sql|dbclient-js|cql|postgres/) && !(resourceFilename =~ /.sql$/)"
      },
      {
        "key": "ctrl+f12",
        "command": "workbench.action.debug.stop",
        "when": "inDebugMode"
      },
      {
        "key": "ctrl+f12",
        "command": "proKeybindings.smartRun",
        "when": "!inDebugMode"
      },
      {
        "key": "ctrl+1",
        "command": "editor.action.commentLine",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "key": "ctrl+f4",
        "command": "editor.action.joinLines",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+f3",
        "command": "editor.toggleFold",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+a",
        "command": "editor.action.selectAll",
        "when": "editorTextFocus"
      },
      {
        "key": "shift+alt+down",
        "command": "editor.action.copyLinesDownAction",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "key": "shift+alt+up",
        "command": "editor.action.copyLinesUpAction",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "key": "alt+down",
        "command": "editor.action.moveLinesDownAction",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "key": "alt+up",
        "command": "editor.action.moveLinesUpAction",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "key": "ctrl+f6",
        "command": "proKeybindings.formatWithConsoles",
        "when": "editorTextFocus && resourceExtname =~ /\\.(ts|tsx|js|jsx|mjs|cjs|vue|svelte|astro)$/"
      },
      {
        "key": "ctrl+shift+a",
        "command": "proKeybindings.openSelectedFolderInNewWindow",
        "when": "filesExplorerFocus"
      },
      {
        "key": "ctrl+r",
        "command": "proKeybindings.openAsNewProject",
        "when": "filesExplorerFocus"
      },
      {
        "key": "ctrl+f10",
        "command": "proKeybindings.openGitHubDesktop"
      },
      {
        "key": "ctrl+f8",
        "command": "proKeybindings.quickCommit"
      },
      {
        "key": "ctrl+f9",
        "command": "proKeybindings.commitMessagePicker"
      },
      {
        "key": "ctrl+f7",
        "command": "proKeybindings.detectProjectType"
      },
      {
        "key": "ctrl+f2",
        "command": "workbench.action.openGlobalKeybindingsFile"
      },
      {
        "key": "ctrl+f1",
        "command": "workbench.action.openSettingsJson"
      },
      {
        "key": "ctrl+shift+[Semicolon]",
        "command": "workbench.action.terminal.new",
        "when": "terminalProcessSupported || terminalWebExtensionContributedProfile"
      }
    ]
  }
}
