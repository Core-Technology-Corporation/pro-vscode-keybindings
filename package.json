{
  "name": "pro-vscode-keybindings",
  "displayName": "Pro VSCode Keybindings",
  "description": "Professional, productivity-focused keyboard shortcuts for Visual Studio Code.",
  "version": "1.0.1",
  "publisher": "alvarosiles",
  "license": "MIT",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.93.0"
  },
  "main": "./dist/extension.js",
  "categories": [
    "Keymaps",
    "Other"
  ],
  "keywords": [
    "keybindings",
    "keymap",
    "shortcuts",
    "productivity",
    "keyboard",
    "git",
    "debug",
    "terminal",
    "copilot"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/alvarosiles/pro-vscode-keybindings.git"
  },
  "bugs": {
    "url": "https://github.com/alvarosiles/pro-vscode-keybindings/issues"
  },
  "homepage": "https://github.com/alvarosiles/pro-vscode-keybindings#readme",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "scripts": {
    "build:keybindings": "node scripts/build.js",
    "build:extension": "esbuild extension/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18",
    "build": "npm run build:keybindings && npm run build:extension",
    "watch": "npm run build:extension -- --watch",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.93.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "proKeybindings.detectProjectType",
        "title": "Pro Keybindings: Detect Project Type"
      },
      {
        "command": "proKeybindings.smartRun",
        "title": "Pro Keybindings: Smart Run (Debug / Web / Package)"
      },
      {
        "command": "proKeybindings.quickCommit",
        "title": "Pro Keybindings: Quick Commit (fill Summary/Description)"
      },
      {
        "command": "proKeybindings.openGitHubDesktop",
        "title": "Pro Keybindings: Open in GitHub Desktop"
      },
      {
        "command": "proKeybindings.commitMessagePicker",
        "title": "Pro Keybindings: Commit Message Picker"
      }
    ],
    "keybindings": [
      {
        "key": "f5",
        "command": "mysql.runSQLWithoutParse",
        "when": "editorLangId =~ /sql|dbclient-js|cql|postgres/ || resourceFilename =~ /.sql$/"
      },
      {
        "key": "f12",
        "command": "workbench.action.debug.stop",
        "when": "inDebugMode"
      },
      {
        "key": "f12",
        "command": "proKeybindings.smartRun",
        "when": "!inDebugMode"
      },
      {
        "key": "ctrl+1",
        "command": "editor.action.commentLine",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "key": "f4",
        "command": "editor.action.joinLines",
        "when": "editorTextFocus"
      },
      {
        "key": "f3",
        "command": "editor.toggleFold",
        "when": "editorTextFocus"
      },
      {
        "key": "f10",
        "command": "proKeybindings.openGitHubDesktop"
      },
      {
        "key": "f8",
        "command": "proKeybindings.quickCommit"
      },
      {
        "key": "f9",
        "command": "proKeybindings.commitMessagePicker"
      },
      {
        "key": "f7",
        "command": "proKeybindings.detectProjectType"
      },
      {
        "key": "f2",
        "command": "workbench.action.openGlobalKeybindingsFile"
      },
      {
        "key": "f1",
        "command": "workbench.action.openSettingsJson"
      }
    ]
  }
}
