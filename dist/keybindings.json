[
  {
    "key": "f5",
    "command": "mysql.runSQLWithoutParse",
    "when": "editorLangId =~ /sql|dbclient-js|cql|postgres/ || resourceFilename =~ /.sql$/"
  },
  {
    "key": "f9",
    "command": "workbench.action.debug.stop",
    "when": "inDebugMode"
  },
  {
    "key": "f9",
    "command": "proKeybindings.smartRun",
    "when": "!inDebugMode"
  },
  {
    "key": "ctrl+1",
    "command": "editor.action.commentLine",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "f4",
    "command": "editor.action.joinLines",
    "when": "editorTextFocus"
  },
  {
    "key": "f3",
    "command": "editor.toggleFold",
    "when": "editorTextFocus"
  },
  {
    "key": "f11",
    "command": "proKeybindings.openGitHubDesktop"
  },
  {
    "key": "f12",
    "command": "proKeybindings.quickCommit"
  },
  {
    "key": "f10",
    "command": "proKeybindings.detectProjectType"
  },
  {
    "key": "f2",
    "command": "workbench.action.openGlobalKeybindingsFile"
  },
  {
    "key": "f1",
    "command": "workbench.action.openSettingsJson"
  }
]
