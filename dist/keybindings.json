[
  {
    "key": "ctrl+shift+c+v",
    "command": "workbench.view.extension.claude-sessions-sidebar"
  },
  {
    "key": "ctrl+shift+c",
    "command": "workbench.view.extension.claude-sidebar-secondary"
  },
  {
    "key": "ctrl+f5",
    "command": "mysql.runSQLWithoutParse",
    "when": "editorLangId =~ /sql|dbclient-js|cql|postgres/ || resourceFilename =~ /.sql$/"
  },
  {
    "key": "ctrl+f5",
    "command": "workbench.action.reloadWindow",
    "when": "!(editorLangId =~ /sql|dbclient-js|cql|postgres/) && !(resourceFilename =~ /.sql$/)"
  },
  {
    "key": "ctrl+f12",
    "command": "workbench.action.debug.stop",
    "when": "inDebugMode"
  },
  {
    "key": "ctrl+f12",
    "command": "proKeybindings.smartRun",
    "when": "!inDebugMode"
  },
  {
    "key": "ctrl+1",
    "command": "editor.action.commentLine",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+f4",
    "command": "editor.action.joinLines",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+f3",
    "command": "editor.toggleFold",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+a",
    "command": "editor.action.selectAll",
    "when": "editorTextFocus"
  },
  {
    "key": "shift+alt+down",
    "command": "editor.action.copyLinesDownAction",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "shift+alt+up",
    "command": "editor.action.copyLinesUpAction",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "alt+down",
    "command": "editor.action.moveLinesDownAction",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "alt+up",
    "command": "editor.action.moveLinesUpAction",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+f6",
    "command": "proKeybindings.formatWithConsoles",
    "when": "editorTextFocus && resourceLangId =~ /^(javascript|typescript|javascriptreact|typescriptreact)$/"
  },
  {
    "key": "ctrl+shift+a",
    "command": "proKeybindings.openSelectedFolderInNewWindow",
    "when": "filesExplorerFocus"
  },
  {
    "key": "ctrl+r",
    "command": "proKeybindings.openAsNewProject",
    "when": "filesExplorerFocus"
  },
  {
    "key": "ctrl+f10",
    "command": "proKeybindings.openGitHubDesktop"
  },
  {
    "key": "ctrl+f8",
    "command": "proKeybindings.quickCommit"
  },
  {
    "key": "ctrl+f9",
    "command": "proKeybindings.commitMessagePicker"
  },
  {
    "key": "ctrl+f7",
    "command": "proKeybindings.detectProjectType"
  },
  {
    "key": "ctrl+f2",
    "command": "workbench.action.openGlobalKeybindingsFile"
  },
  {
    "key": "ctrl+f1",
    "command": "workbench.action.openSettingsJson"
  },
  {
    "key": "ctrl+shift+[Semicolon]",
    "command": "workbench.action.terminal.new",
    "when": "terminalProcessSupported || terminalWebExtensionContributedProfile"
  }
]
